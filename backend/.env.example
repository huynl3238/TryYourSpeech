PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ielts_speaking
DB_USER=postgres
DB_PASSWORD=postgres

REDIS_URL=redis://localhost:6379

OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_FEEDBACK_MODEL=gpt-4.1-mini
# Optional: override the OpenAI-compatible endpoint (e.g. a proxy). Leave empty for OpenAI.
OPENAI_BASE_URL=
# Optional: enables word/phoneme pronunciation detail. OpenAI scoring still runs without Azure.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=en-US

# AI scoring safety switches.
# Master gate for audio upload + AI assessment. Leave unset/false to keep AI OFF
# (upload endpoint returns 503, no OpenAI/Azure calls are ever made).
AI_AUDIO_UPLOAD_ENABLED=false
# Hard monthly cap on AI-assessed turns to protect the budget. 0 disables the cap.
AI_MONTHLY_ASSESSMENT_LIMIT=250

ICE_SERVERS=[]

# --- Authentication (Google OAuth2 + JWT) ---
# Chuỗi bí mật để ký JWT. Tạo bằng: openssl rand -base64 48
JWT_SECRET=
# OAuth 2.0 Client ID lấy từ Google Cloud Console (loại "Web application")
GOOGLE_CLIENT_ID=
# Tuỳ chọn — thời hạn token (mặc định: 900 giây / 30 ngày)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Đăng nhập bằng email + mật khẩu: xác minh email và "quên mật khẩu" đều cần
# gửi mail. Thiếu nhóm này thì các API mật khẩu trả 503, đăng nhập Google vẫn chạy.
# RESEND_API_KEY lấy ở https://resend.com (Sending access, giới hạn theo tên miền).
RESEND_API_KEY=
EMAIL_FROM=Try Your Speech <no-reply@your-domain.example>
# Địa chỉ gốc của giao diện, dùng để dựng link trong email.
APP_URL=http://localhost:5173
